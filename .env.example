NODE_ENV=production

# Backend API used by the Next.js same-origin proxy.
# Use the backend subdomain you create in Plesk.
BACKEND_API_URL=https://api.oneklient.com

# Optional direct browser-to-backend URL. Leave empty to avoid CORS and use /api/* proxy routes.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_API_WITH_CREDENTIALS=false
